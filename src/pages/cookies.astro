---
import Base from '../layouts/Base.astro';
import empresa from '../content/empresa.json';
// Si se añade analítica con cookies o contenido de terceros (YouTube, Maps), hay que añadir un banner de consentimiento.
---

<Base titulo="Política de cookies" descripcion={`Uso de cookies en la web de ${empresa.nombre}.`}>
  <section class="seccion">
    <div class="contenedor prosa">
      <h1>Política de cookies</h1>
      <p>
        Esta web no usa cookies de análisis, publicidad ni de terceros. Solo podría usar cookies técnicas,
        imprescindibles para que funcione, que no necesitan consentimiento.
      </p>
      <p>
        Si en el futuro se añaden otras cookies, se pedirá tu consentimiento antes de activarlas y se actualizará
        esta página.
      </p>
    </div>
  </section>
</Base>
