---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const servicios = await getCollection('servicios');
  return servicios.map((s) => ({ params: { slug: s.id }, props: { servicio: s } }));
}
const { servicio } = Astro.props;
const { Content } = await render(servicio);
---

<Base titulo={servicio.data.titulo} descripcion={servicio.data.resumen}>
  <article class="seccion">
    <div class="contenedor prosa">
      <a href="/servicios/">← Servicios</a>
      <h1>{servicio.data.titulo}</h1>
      <p class="seccion__intro">{servicio.data.resumen}</p>
      <Content />
      <p><a class="boton" href="/contacto/">Pide información</a></p>
    </div>
  </article>
</Base>
