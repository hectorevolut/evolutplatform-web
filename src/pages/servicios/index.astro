---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
const servicios = (await getCollection('servicios')).sort((a, b) => a.data.orden - b.data.orden);
---

<Base titulo="Servicios" descripcion="Servicios que ofrecemos.">
  <section class="seccion">
    <div class="contenedor">
      <h1>Servicios</h1>
      <div class="rejilla">
        {
          servicios.map((s) => (
            <article class="tarjeta">
              <h2 style="font-size:1.25rem">{s.data.titulo}</h2>
              <p>{s.data.resumen}</p>
              <a class="mas" href={`/servicios/${s.id}/`}>Más información →</a>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Base>
