---
import Base from '../layouts/Base.astro';
import FormularioContacto from '../components/FormularioContacto.astro';
import empresa from '../content/empresa.json';

// Esta página se genera en el servidor para poder mostrar el resultado del envío.
export const prerender = false;
const enviado = Astro.url.searchParams.has('enviado');
const error = Astro.url.searchParams.has('error');
---

<Base titulo="Contacto" descripcion={`Contacta con ${empresa.nombre}.`}>
  <section class="seccion">
    <div class="contenedor">
      <h1>Contacto</h1>
      <p class="seccion__intro">
        Cuéntanos qué necesitas y te responderemos lo antes posible. También puedes escribir a{' '}
        <a href={`mailto:${empresa.email}`}>{empresa.email}</a>.
      </p>
      {enviado && <p class="aviso aviso--ok" role="status">Mensaje enviado. Gracias, te responderemos pronto.</p>}
      {error && <p class="aviso aviso--error" role="alert">No se pudo enviar. Revisa los campos o escríbenos por correo.</p>}
      {!enviado && <FormularioContacto tipos={['Fabricante', 'Constructora', 'Cuadrilla de montaje', 'Otro']} />}
    </div>
  </section>
</Base>

<style>
  .aviso { padding: 1rem 1.25rem; border-radius: var(--radio); max-width: 36rem; }
  .aviso--ok { background: #dcfce7; color: #14532d; }
  .aviso--error { background: #fee2e2; color: #7f1d1d; }
</style>
