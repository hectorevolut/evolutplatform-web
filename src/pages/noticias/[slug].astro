---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const noticias = await getCollection('noticias');
  return noticias.map((n) => ({ params: { slug: n.id }, props: { noticia: n } }));
}
const { noticia } = Astro.props;
const { Content } = await render(noticia);
---

<Base titulo={noticia.data.titulo} descripcion={noticia.data.resumen}>
  <article class="seccion">
    <div class="contenedor prosa">
      <a href="/noticias/">← Noticias</a>
      <h1>{noticia.data.titulo}</h1>
      <Content />
    </div>
  </article>
</Base>
