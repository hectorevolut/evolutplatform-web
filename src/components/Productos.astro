---
// Sección 4 · Qué creamos: Estimator y Tracker (D-146: «estamos creando», sin venta).
import Icono from "./Icono.astro";
import { LINKEDIN, type Idioma } from "../i18n";
import { textos } from "../textos";

interface Props { idioma: Idioma; }
const t = textos[Astro.props.idioma].productos;
const iconos = ["presupuesto", "control"] as const;
---
<section class="seccion productos" id="products">
  <div class="contenedor">
    <p class="etiqueta">{t.etiqueta}</p>
    <h2>{t.titulo}</h2>
    <div class="tarjetas">
      {t.lista.map(([nombre, estado, texto], i) => (
        <article class="tarjeta">
          <Icono nombre={iconos[i]} />
          <p class:list={["estado", { previsto: i === 1 }]}>{estado}</p>
          <h3>{nombre}</h3>
          <p class="texto">{texto}</p>
        </article>
      ))}
    </div>
    <a class="enlace" href={LINKEDIN} target="_blank" rel="noopener noreferrer">{t.enlace}</a>
  </div>
</section>

<style>
  .productos { background: var(--galvanizado); }
  .tarjetas { display: grid; gap: var(--rejilla-medianil-movil); margin: 32px 0; }
  .tarjeta { background: var(--blanco); border: 1px solid var(--filete); border-radius: 8px; padding: 32px; }
  .texto { color: var(--gris); margin: 0; }
  /* Estado en píldora: en desarrollo, borde señal; previsto, discontinuo */
  .estado {
    display: inline-block; margin: 0 0 12px; padding: 2px 12px; border-radius: 999px;
    border: 2px solid var(--senal); font-family: var(--fuente-datos); font-size: 13px; font-weight: 700;
  }
  .estado.previsto { border: 2px dashed var(--gris); }
  @media (min-width: 900px) { .tarjetas { grid-template-columns: repeat(2, 1fr); gap: var(--rejilla-medianil); } }
</style>
