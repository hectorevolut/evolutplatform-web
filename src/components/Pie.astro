---
import empresa from '../content/empresa.json';
const anio = new Date().getFullYear();
---

<footer class="pie">
  <div class="contenedor pie__fila">
    <div>
      <strong>{empresa.nombre}</strong>
      <p>
        {empresa.razonSocial}{empresa.nif && ` · ${empresa.nif}`}<br />
        <a href={`mailto:${empresa.email}`}>{empresa.email}</a>
        {empresa.telefono && <> · <a href={`tel:${empresa.telefono.replace(/\s/g, '')}`}>{empresa.telefono}</a></>}
      </p>
    </div>
    <nav aria-label="Legal">
      <ul>
        <li><a href="/aviso-legal/">Aviso legal</a></li>
        <li><a href="/privacidad/">Privacidad</a></li>
        <li><a href="/cookies/">Cookies</a></li>
        {
          empresa.livroReclamacoes && (
            <li><a href="https://www.livroreclamacoes.pt/" rel="noopener" target="_blank">Livro de Reclamações</a></li>
          )
        }
      </ul>
    </nav>
  </div>
  <p class="contenedor pie__copy">© {anio} {empresa.razonSocial}</p>
</footer>

<style>
  .pie { background: var(--color-marca-oscuro); color: #cbd5e1; padding-block: 3rem 1.5rem; margin-top: 0; }
  .pie a { color: #fff; }
  .pie strong { color: #fff; font-size: 1.125rem; }
  .pie__fila { display: flex; justify-content: space-between; gap: 2rem; flex-wrap: wrap; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
  .pie__copy { font-size: 0.875rem; margin-top: 2rem; color: #94a3b8; }
</style>
