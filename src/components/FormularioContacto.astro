---
// Formulario que funciona sin JavaScript: envía a /api/contacto y vuelve con ?enviado=1 o ?error=1.
interface Props {
  tipos?: string[]; // opciones del desplegable "Soy…"; vacío = sin desplegable
}
const { tipos = [] } = Astro.props;
---

<form class="formulario" method="post" action="/api/contacto">
  <div class="campo">
    <label for="nombre">Nombre</label>
    <input id="nombre" name="nombre" autocomplete="name" required maxlength="120" />
  </div>
  <div class="campo">
    <label for="email">Correo electrónico</label>
    <input id="email" name="email" type="email" autocomplete="email" required maxlength="200" />
  </div>
  {
    tipos.length > 0 && (
      <div class="campo">
        <label for="tipo">Soy…</label>
        <select id="tipo" name="tipo">
          {tipos.map((t) => <option>{t}</option>)}
        </select>
      </div>
    )
  }
  <div class="campo">
    <label for="mensaje">Mensaje</label>
    <textarea id="mensaje" name="mensaje" rows="6" required maxlength="5000"></textarea>
  </div>
  <!-- Campo trampa contra robots: las personas no lo ven -->
  <div class="solo-lectores" aria-hidden="true">
    <label for="web">No rellenar</label>
    <input id="web" name="web" tabindex="-1" autocomplete="off" />
  </div>
  <label class="consentimiento">
    <input type="checkbox" name="privacidad" required />
    <span>He leído la <a href="/privacidad/">política de privacidad</a> y acepto que usen mis datos para responderme.</span>
  </label>
  <button class="boton" type="submit">Enviar</button>
</form>

<style>
  .formulario { display: grid; gap: 1rem; max-width: 36rem; }
  .campo { display: grid; gap: 0.35rem; }
  label { font-weight: 600; font-size: 0.9375rem; }
  input, select, textarea {
    font: inherit; padding: 0.7rem 0.8rem; border: 1px solid #cbd5e1; border-radius: var(--radio); background: #fff; color: var(--color-texto);
  }
  .consentimiento { display: flex; gap: 0.6rem; align-items: flex-start; font-weight: 400; font-size: 0.9375rem; }
  .consentimiento input { margin-top: 0.3rem; }
  .boton { justify-self: start; }
</style>
