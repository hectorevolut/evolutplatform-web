---
// Bucle del hero (D-087): cada obra alimenta la siguiente. SVG en línea, sin imágenes externas.
// Los textos llegan del idioma de la página (textos.ts).
interface Props { pasos: readonly string[]; centro: readonly string[]; }
const { pasos, centro } = Astro.props;
// Posición de cada píldora (centro x, y): arriba, derecha, abajo, izquierda
const pos = [[243, 52], [403, 210], [243, 368], [83, 210]];
---
<svg class="bucle" viewBox="0 0 486 420" role="img" aria-label={`${pasos.join(" → ")} → ${centro.join(" ")}`}>
  <defs>
    <marker id="punta" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" fill="#1E3447" />
    </marker>
  </defs>
  <!-- Flechas en el sentido de las agujas del reloj -->
  <g fill="none" stroke="#1E3447" stroke-width="2" marker-end="url(#punta)">
    <path d="M325 78 Q388 108 396 178" />
    <path d="M396 242 Q388 312 325 342" />
    <path d="M161 342 Q98 312 90 242" />
    <path d="M90 178 Q98 108 161 78" />
  </g>
  {pasos.map((p, i) => {
    const [x, y] = pos[i];
    const datos = i === 3; // «Data»: la píldora en señal
    return (
      <g>
        <rect x={x - 75} y={y - 22} width="150" height="44" rx="22"
          fill={datos ? "#E8622C" : "#FFFFFF"} stroke={datos ? "#E8622C" : "#1E3447"} stroke-width="2" />
        <text x={x} y={y + 6} text-anchor="middle" font-family="IBM Plex Sans, sans-serif" font-weight="700"
          font-size="16" fill={datos ? "#14202B" : "#1E3447"}>{p}</text>
      </g>
    );
  })}
