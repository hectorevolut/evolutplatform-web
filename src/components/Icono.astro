---
// Iconos de línea propios (SVG en la página, sin librerías ni ficheros externos).
// Trazo acero y un acento en señal. Decorativos: aria-hidden, el texto de la tarjeta ya lo dice.
interface Props { nombre: "excel" | "desviacion" | "sin-datos" | "presupuesto" | "control"; }
const { nombre } = Astro.props;
---
<span class="icono" aria-hidden="true">
  <svg viewBox="0 0 48 48" fill="none" stroke="#1E3447" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
    {nombre === "excel" && (
      <>
        {/* Hoja de cálculo… */}
        <rect x="5" y="6" width="28" height="32" rx="2" />
        <path d="M5 15h28M5 24h28M5 33h18M15 6v32" />
        {/* …y el reloj: días */}
        <circle cx="35" cy="34" r="9" fill="#FFFFFF" stroke="#E8622C" />
        <path d="M35 29v5l3.5 2.5" stroke="#E8622C" />
      </>
    )}
    {nombre === "desviacion" && (
      <>
        {/* Ejes */}
        <path d="M6 6v36h36" />
        {/* Lo previsto (discontinuo)… */}
        <path d="M9 34L41 24" stroke-dasharray="3 4" />
        {/* …y lo real, que se dispara al final */}
        <path d="M9 34l11-4 9-5 7-13" stroke="#E8622C" />
        <circle cx="38" cy="9" r="3.5" fill="#E8622C" stroke="#E8622C" />
      </>
    )}
    {nombre === "sin-datos" && (
      <>
        {/* Eslabón roto: los datos de una obra no pasan a la siguiente */}
        <path d="M21 13l-3-3a8 8 0 0 0-11.3 11.3l5 5a8 8 0 0 0 9.5 1.3" />
        <path d="M27 35l3 3a8 8 0 0 0 11.3-11.3l-5-5a8 8 0 0 0-9.5-1.3" />
        <path d="M17 31l-3 3M31 17l3-3M24 6v4M24 38v4" stroke="#E8622C" />
      </>
    )}
    {nombre === "presupuesto" && (
      <>
        {/* Oferta en PDF: documento con partidas y total */}
        <path d="M11 4h18l9 9v29a2 2 0 0 1-2 2H11a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z" />
        <path d="M29 4v9h9" />
        <path d="M15 21h12M15 27h12M15 33h6" />
        <path d="M25 37h8" stroke="#E8622C" stroke-width="3" />
      </>
    )}
    {nombre === "control" && (
      <>
        {/* Control de obra: avance que se ve mientras ocurre */}
        <rect x="5" y="8" width="38" height="32" rx="2" />
        <path d="M5 16h38" />
        <path d="M11 24h18M11 31h11" />
        <path d="M11 24h10M11 31h6" stroke="#E8622C" stroke-width="3" />
        <circle cx="36" cy="30" r="4" stroke="#E8622C" />
      </>
    )}
  </svg>
</span>

<style>
  .icono {
    display: flex;  /* bloque: lo que va detrás empieza en otra línea */ align-items: center; justify-content: center;
    width: 64px; height: 64px; border-radius: 8px; background: var(--galvanizado);
    margin-bottom: 20px;
  }
  .icono svg { width: 44px; height: 44px; }
</style>
