---
import '../styles/global.css';
import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';
import empresa from '../content/empresa.json';

interface Props {
  titulo: string;
  descripcion: string;
  imagen?: string;
}
const { titulo, descripcion, imagen } = Astro.props;
const tituloCompleto = Astro.url.pathname === '/' ? titulo : `${titulo} | ${empresa.nombre}`;
const canonica = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    {imagen && <meta property="og:image" content={new URL(imagen, Astro.site)} />}
    <meta name="theme-color" content="#0f172a" />
  </head>
  <body>
    <a class="solo-lectores" href="#contenido">Saltar al contenido</a>
    <Cabecera />
    <main id="contenido">
      <slot />
    </main>
    <Pie />
  </body>
</html>
