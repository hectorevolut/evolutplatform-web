# Copia este fichero como .env (no se sube a GitHub) y rellénalo.
# En Hostinger, estas mismas variables se ponen en la configuración de la web app.

# En Hostinger: escuchar en todas las interfaces (el puerto lo pone Hostinger en PORT)
HOST=0.0.0.0

# Dirección pública de la web
SITE_URL=https://evolutplatform.es

# Correo para el formulario de contacto (buzón de Hostinger u otro SMTP)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=web@evolutplatform.es
SMTP_PASS=
CONTACTO_DESTINO=contacto@evolutplatform.es

# Panel /keystatic guardando en GitHub (vacío = guarda en los ficheros locales)
PUBLIC_KEYSTATIC_REPO=
